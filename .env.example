# Server-side Cloudflare R2 credentials. Never expose these with NEXT_PUBLIC_ names.
Access_Key_ID=
Secret_Access_Key=
Account_ID=
S3_API_endpoint=
Your_API_Token=

# Optional overrides used by scripts/sync-images-to-r2.mjs.
R2_BUCKET_NAME=karthikeya-portfolio-images
R2_OBJECT_PREFIX=Images

# Public, browser-safe URL populated after public bucket access is enabled.
NEXT_PUBLIC_R2_PUBLIC_URL=
